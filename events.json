{
  "schema": 3,
  "layers": [
    "plugin"
  ],
  "events": {
    "plugin.terminal.ime": {
      "layer": "plugin",
      "class": "input",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "shift": {
            "type": "boolean"
          },
          "alt": {
            "type": "boolean"
          },
          "ctrl": {
            "type": "boolean"
          },
          "selectedRange": {
            "type": [
              "object",
              "null"
            ]
          },
          "replacementRange": {
            "type": [
              "object",
              "null"
            ]
          },
          "attributed": {
            "type": "boolean"
          },
          "cids": {
            "type": "array"
          }
        },
        "required": [
          "kind"
        ]
      },
      "description": "A native callback of the input method (insert, key, compose) with every field it carries, the typed text and the ranges included."
    },
    "plugin.terminal.input": {
      "layer": "plugin",
      "class": "input",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "shift": {
            "type": "boolean"
          },
          "alt": {
            "type": "boolean"
          },
          "ctrl": {
            "type": "boolean"
          },
          "selectedRange": {
            "type": [
              "object",
              "null"
            ]
          },
          "replacementRange": {
            "type": [
              "object",
              "null"
            ]
          },
          "attributed": {
            "type": "boolean"
          },
          "focused": {
            "type": "boolean"
          },
          "selector": {
            "type": "string"
          },
          "queued": {
            "type": "boolean"
          },
          "queue": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "queued",
          "queue"
        ]
      },
      "description": "One input of the terminal with every field it carries; queued is true while the input waits for the session and queue is the number of inputs that wait."
    },
    "plugin.terminal.wheel": {
      "layer": "plugin",
      "class": "input",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deltaY": {
            "type": "number"
          },
          "deltaMode": {
            "type": "number"
          },
          "cellHeight": {
            "type": "number"
          },
          "lines": {
            "type": "number"
          },
          "carry": {
            "type": "number"
          }
        },
        "required": [
          "deltaY",
          "deltaMode",
          "cellHeight",
          "lines",
          "carry"
        ]
      },
      "description": "A wheel gesture over the terminal: its vertical move and unit, the cell height, the whole lines it sends (0 for a move smaller than a line) and the carry that waits for the next move."
    },
    "plugin.terminal.input.flush": {
      "layer": "plugin",
      "class": "input",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          }
        },
        "required": [
          "count"
        ]
      },
      "description": "The inputs that waited for the session are sent, count of them."
    },
    "plugin.terminal.input.refused": {
      "layer": "plugin",
      "class": "input",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          }
        },
        "required": [
          "count"
        ]
      },
      "description": "The session failed, and the inputs whose callers waited for it ended, count of them."
    },
    "plugin.terminal.input.overflow": {
      "layer": "plugin",
      "class": "input",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "max": {
            "type": "number"
          },
          "queue": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "max",
          "queue"
        ]
      },
      "description": "An input is refused because the queue of inputs that wait for the session holds max inputs; the input is rejected with an error."
    },
    "plugin.terminal.input.unanswered.unheld": {
      "layer": "plugin",
      "class": "input",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "characters": {
            "type": "number"
          },
          "maxCharacters": {
            "type": "number"
          }
        },
        "required": [
          "characters",
          "maxCharacters"
        ]
      },
      "description": "The text of an input without an answer of the service is not held, because it or the held inputs reach the limit of the characters. Nothing is lost by this: an answer still ends the input, and a service that ends first records input.unanswered.lost."
    },
    "plugin.terminal.input.unanswered.lost": {
      "layer": "plugin",
      "class": "input",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "characters": {
            "type": "number"
          }
        },
        "required": [
          "count",
          "characters"
        ]
      },
      "description": "The service ended without an answer of these inputs and their text was not held, so the new session does not take them."
    },
    "plugin.terminal.input.unanswered.unfollowed": {
      "layer": "plugin",
      "class": "input",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "max": {
            "type": "number"
          }
        },
        "required": [
          "max"
        ]
      },
      "description": "The oldest input without an answer leaves, because the inputs without an answer reached the limit of their count: nothing records what becomes of it."
    },
    "plugin.terminal.input.unanswered.discarded": {
      "layer": "plugin",
      "class": "input",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "count",
          "reason"
        ]
      },
      "description": "Inputs without an answer of the service are no longer tracked and are not sent again, because their session stayed open, ended or closed; the session may have applied them. Count of them and the reason."
    },
    "plugin.terminal.input.unanswered.resent": {
      "layer": "plugin",
      "class": "input",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          }
        },
        "required": [
          "count"
        ]
      },
      "description": "A new session takes the inputs that the service that ended did not answer, count of them."
    },
    "plugin.terminal.session.gate": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "open": {
            "type": "boolean"
          },
          "event": {
            "type": "string"
          },
          "connected": {
            "type": "boolean"
          }
        },
        "required": [
          "open",
          "event"
        ]
      },
      "description": "The session gate opened or closed because of the sidecar event named in event; inputs wait while it is closed."
    },
    "plugin.terminal.session.open": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "shell": {
            "type": "string"
          },
          "directory": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "shell",
          "directory"
        ]
      },
      "description": "The terminal asks the sidecar to open its session with the shell and the working directory."
    },
    "plugin.terminal.close": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "required": []
      },
      "description": "The terminal ends its session at the removal of the surface."
    },
    "plugin.terminal.send": {
      "layer": "plugin",
      "class": "io",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "body": {
            "type": "object"
          }
        },
        "required": [
          "body"
        ]
      },
      "description": "A message to the sidecar with its whole body."
    },
    "plugin.terminal.send.result": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation": {
            "type": [
              "string",
              "null"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "micros": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "operation",
          "ok",
          "micros"
        ]
      },
      "description": "The result of a message to the sidecar; error is <code>: <text> when ok is false."
    },
    "plugin.terminal.session.rejected.shed": {
      "layer": "plugin",
      "class": "io",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "count": {
            "type": "number"
          }
        },
        "required": [
          "count"
        ]
      },
      "description": "A rejected sequence reason was dropped from the list of the kept reasons; count is the running count of the dropped reasons of the session."
    },
    "plugin.terminal.sidecar.unknown": {
      "layer": "plugin",
      "class": "io",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          }
        },
        "required": [
          "event"
        ]
      },
      "description": "The sidecar sent an event that the terminal does not handle; event is its name."
    },
    "plugin.terminal.sidecar.event": {
      "layer": "plugin",
      "class": "io",
      "level": "trace",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "body": {
            "type": "object"
          }
        },
        "required": [
          "body"
        ]
      },
      "description": "An event of the sidecar with its whole body, before the terminal handles it."
    },
    "plugin.terminal.region": {
      "layer": "plugin",
      "class": "input",
      "level": "trace",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "focused": {
            "type": "boolean"
          },
          "selector": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "cids": {
            "type": "array"
          }
        },
        "required": [
          "type"
        ]
      },
      "description": "An event of the image region with its type and its whole body, before the terminal handles it."
    },
    "plugin.terminal.screen.refused": {
      "layer": "plugin",
      "class": "frame",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "previous": {
            "type": "number"
          }
        },
        "required": [
          "number",
          "previous"
        ]
      },
      "description": "A change form arrived while the view awaited the full form that answers its screen read, and the view refused it; number and previous are the members of the change."
    },
    "plugin.terminal.screen.rows.unmatched": {
      "layer": "plugin",
      "class": "io",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "from": {
            "type": "number"
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "from",
          "count"
        ]
      },
      "description": "A screen.rows reply of the sidecar arrived for a range that no terminal.screen.rows read waits for, such as a read that a connection change already ended; from and count are the range of the reply."
    },
    "plugin.terminal.messages.unmatched": {
      "layer": "plugin",
      "class": "io",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "refused": {
            "type": "boolean"
          }
        },
        "required": [
          "refused"
        ]
      },
      "description": "A reply of the sidecar arrived for a messages request that no longer waits, such as a request that the end of the sidecar connection or the close of the view already ended; refused is whether the reply is a refusal {error, reason}."
    },
    "plugin.terminal.messages.delivered": {
      "layer": "plugin",
      "class": "io",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "injected",
              "refused",
              "skipped"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "seq",
          "path",
          "from",
          "state",
          "reason"
        ]
      },
      "description": "The page decided the delivery of a message of its registration (core docs/spec/messaging.md#delivery): seq, path and from are those of the file event, state is injected, refused or skipped, and reason is null for injected and the reason of a refused or skipped message."
    },
    "plugin.terminal.messages.role.delivered": {
      "layer": "plugin",
      "class": "io",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "role-first",
              "role-change",
              "role-reread"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "description": "The page injected a role message of its tab (core docs/spec/agent-roles.md): kind is role-first (the first message of a program launched with a role), role-change (the change message) or role-reread (a reread request). A refused injection is shown through the error display, not through this event."
    },
    "plugin.terminal.messages.held": {
      "layer": "plugin",
      "class": "io",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "blocked",
              "notice",
              "composition",
              "typing",
              "input-held",
              null
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "permission",
              "question",
              "auth",
              null
            ]
          },
          "pending": {
            "type": "integer"
          }
        },
        "required": [
          "reason",
          "kind",
          "pending"
        ]
      },
      "description": "A hold of the injection of the messages started, changed its reason or ended (core docs/spec/messaging.md#hold-for-the-person): reason is the first reason that applies, or null at the end, kind is the kind of a blocked record or null, and pending is the number of messages that wait."
    },
    "plugin.terminal.clipboard.refused": {
      "layer": "plugin",
      "class": "io",
      "level": "info",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "store",
              "query"
            ]
          },
          "policy": {
            "type": "string",
            "enum": [
              "deny",
              "write"
            ]
          }
        },
        "required": [
          "operation",
          "policy"
        ]
      },
      "description": "The clipboard.program setting refused an OSC 52 request of a program; operation is the store or query that was refused and policy is the setting value, and a refused query is answered with clipboard.reject."
    },
    "plugin.terminal.frame": {
      "layer": "plugin",
      "class": "frame",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "session": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "sequence": {
            "type": "number"
          },
          "rows": {
            "type": "number"
          },
          "cols": {
            "type": "number"
          },
          "frame": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "generation": {
                "type": "integer",
                "minimum": 0
              },
              "raster": {
                "type": "integer",
                "minimum": 0
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "generation",
              "raster",
              "sequence"
            ],
            "additionalProperties": false
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "session",
          "segment",
          "sequence",
          "rows",
          "cols",
          "frame",
          "hash"
        ]
      },
      "description": "The accepted native frame tuple or null for the sidecar screen message, its session, replay segment and message sequence, grid dimensions, and the screen SHA-256 as 64 lowercase hexadecimal characters."
    },
    "plugin.terminal.view.content_frame": {
      "layer": "plugin",
      "class": "frame",
      "level": "trace",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "width": { "type": "number", "minimum": 0 },
          "height": { "type": "number", "minimum": 0 },
          "documentTimeOriginMs": { "type": "number", "minimum": 0 },
          "firstResizeAtMs": { "type": "number", "minimum": 0 },
          "resizeAtMs": { "type": "number", "minimum": 0 },
          "resizeCount": { "type": "integer", "minimum": 1 },
          "frameTimeMs": { "type": "number", "minimum": 0 },
          "surface": { "type": "string" }
        },
        "required": ["sequence", "width", "height", "documentTimeOriginMs", "firstResizeAtMs", "resizeAtMs", "resizeCount", "frameTimeMs", "surface"],
        "additionalProperties": false
      },
      "description": "An explicitly observed content-box size after ResizeObserver and the next animation frame, with the first and latest resize times, resize count, frame time, and runtime surface identifier in the view document clock."
    },
    "plugin.terminal.error": {
      "layer": "plugin",
      "class": "lifecycle",
      "level": "error",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "message"
        ]
      },
      "description": "An error that the terminal shows in its session status; source names where it came from."
    }
  }
}
